# Intestazioni HTTP servite da Cloudflare Pages (file letto in fase di deploy).
#
# L'app è un sito statico senza backend: il valore di queste righe è chiudere
# le strade che restano aperte per default. La CSP in particolare è la rete di
# protezione se un giorno una dipendenza compromessa o un dato importato
# riuscisse a iniettare codice nella pagina — senza di lei quel codice
# potrebbe chiamare qualunque server; con lei può parlare solo con Microsoft,
# cioè con gli unici host esterni da cui l'app dipende davvero.
#
# `connect-src` e `frame-src` nominano gli host di Microsoft perché lì passano
# il token e la sincronizzazione OneDrive. Sono più di quelli che verrebbe da
# scrivere, e il motivo non è ovvio: **`GET …:/content` su un file di OneDrive
# non restituisce il file, restituisce un 302** verso l'host di storage vero —
# `my.microsoftpersonalcontent.com` per gli account personali di oggi,
# `*.files.1drv.com` e `*.livefilestore.com` per quelli di ieri,
# `*.sharepoint.com` per quelli aziendali — e quale tocchi dipende
# dall'account e dall'epoca, non dal codice: per questo sono elencati tutti.
# La lista è per sua natura incompleta, perché Microsoft può spostare lo
# storage senza avvisare nessuno. Per questo l'app, quando uno scarico
# fallisce, **nomina l'host**: l'errore dice da solo cosa aggiungere qui. `fetch` segue il redirect da solo, ma la CSP viene applicata anche
# alla destinazione: con il solo `graph.microsoft.com` autorizzato, la lettura
# del file muore lì, e il browser la riporta come un generico «Failed to fetch»
# che sembra un problema di rete. Allo stesso modo gli account Microsoft
# personali (outlook.it, hotmail, live) vengono instradati su `login.live.com`.
# Se un domani la sincronizzazione sparisse, queste voci vanno tolte.
# `frame-ancestors 'none'` impedisce che il sito finisca incorniciato in una
# pagina altrui, che è il modo classico di far cliccare a qualcuno cose che
# non vede.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://graph.microsoft.com https://login.microsoftonline.com https://login.live.com https://*.1drv.com https://*.livefilestore.com https://*.storage.live.com https://*.onedrive.com https://*.microsoftpersonalcontent.com https://*.sharepoint.com; frame-src https://login.microsoftonline.com https://login.live.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self' https://login.microsoftonline.com https://login.live.com; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  # nessuna funzione del dispositivo serve all'app: si spengono tutte
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
